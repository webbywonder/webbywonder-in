{
  // Cloudflare Workers (Static Assets) config for webbywonder.in
  // Committed so the build stops auto-generating one each deploy.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webbywonder-in",
  "compatibility_date": "2026-05-30",
  // Serve the repo root as static assets. What NOT to upload is controlled
  // by .assetsignore (keeps .git and other non-site files out of the bundle).
  "assets": {
    "directory": "."
  },
  // Custom domain (webbywonder.in) is the canonical entry point, so disable
  // the *.workers.dev and preview URLs here too.
  "workers_dev": false,
  "preview_urls": false
}
